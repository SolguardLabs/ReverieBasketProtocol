{
  "name": "reverie-basket-protocol",
  "version": "1.0.0",
  "description": "Infraestructura de cestas tokenizadas con sustituciones programadas de componentes.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:verbose": "hardhat test --network hardhat",
    "clean": "hardhat clean",
    "fmt": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
    "typecheck": "tsc --noEmit --project tsconfig.client.json",
    "ci": "bun run build && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^26.2.0",
    "hardhat": "^2.22.19",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
